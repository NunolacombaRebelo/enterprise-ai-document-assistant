# ---------------------------------------------------------------------------
# Enterprise AI Document Assistant — environment template
#
# Copy this file to `.env` and fill in the values you need. NEVER commit `.env`.
# All variables are optional in Phase 0: the application starts with no real
# credentials and no OpenAI API key.
#
# Values are read by `src/enterprise_ai_document_assistant/core/config.py`
# (pydantic-settings). Inside Docker Compose, these are injected by compose.yaml.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- API (backend) ---------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# --- Frontend / backend communication --------------------------------------
# Native default is http://localhost:8000. Inside Docker Compose this is set to
# http://api:8000 (the internal service name). Do not hardcode it elsewhere.
API_BASE_URL=http://localhost:8000
FRONTEND_PORT=8501

# --- LLM provider (Milestone 3+; not required to start) --------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Optional. Leave empty until Milestone 3. Never commit a real key.
OPENAI_API_KEY=

# --- Embedding provider (Milestone 3+; interface only in Milestone 2) ------
# Configured but NOT required to start. With an empty key the system runs in lexical-only mode;
# upload, chunking, lexical indexing, and search all work without it. No model is downloaded or
# called in Milestone 2. Never commit a real key or internal endpoint.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Vector storage (Milestone 2): embedded ChromaDB -----------------------
# Relative path; runtime data only. Never committed. Volume-backed at /app/.data/vector-store in
# Docker Compose (named volume `vector-data`). See ADR 0007.
VECTOR_STORE_PATH=.data/vector-store
CHROMA_COLLECTION=documents
CHROMA_DISTANCE_FN=cosine

# --- Retrieval (Milestone 2) ------------------------------------------------
# Mode: lexical (BM25 only, always available) | vector | hybrid (BM25 + vector via RRF).
# Defaults to lexical so the app works with no embedding provider configured.
RETRIEVAL_MODE=lexical
RRF_K=60
RETRIEVAL_TOP_K=10
RERANK_ENABLED=false
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
